    <path
        android:pathData="M54,54m-23,0a23,23 0 1,1 46,0a23,23 0 1,1 -46,0"
        android:strokeColor="#8833C8FF"
        android:strokeWidth="1"
        android:fillColor="#00000000" />

    <!-- crescent moon (Luna) -->
